  {\fontsize{7.35}{9.6}\selectfont\raggedright
    \begin{itemize}[leftmargin=0.35cm,labelsep=0.16cm,itemsep=0.11cm,topsep=0pt,parsep=0pt]
      \renewcommand\labelitemi{\textcolor{CVTeal}{\scriptsize\textbullet}}
      #2
    \end{itemize}
  }
  \vspace{0.18cm}
}

\newcommand{\Job}[5]{%
  \noindent\begin{minipage}[t]{0.30cm}\vspace{0.10cm}
    \begin{tikzpicture}\fill[CVBlue] (0,0) circle (0.075cm);\end{tikzpicture}\\[-0.08cm]
    \hspace*{0.072cm}{\color{CVLine}\rule{0.45pt}{1.30cm}}
  \end{minipage}\hspace{0.09cm}%
  \begin{minipage}[t]{\dimexpr\linewidth-0.39cm\relax}\vspace{0pt}
    {\fontsize{9.2}{11.2}\selectfont\bfseries\color{CVNavy}#1}\par
    \begin{tabularx}{\linewidth}{@{}>{\raggedright\arraybackslash}X>{\raggedleft\arraybackslash}p{3.24cm}@{}}
      {\fontsize{7.7}{9.5}\selectfont\bfseries\color{CVBlue}#2} &
      {\fontsize{7.35}{9.5}\selectfont\color{CVMuted}#3}
    \end{tabularx}
    \vspace{0.02cm}
    {\fontsize{8.1}{10.7}\selectfont\color{CVInk}#4}\par
  \end{minipage}\par
  \vspace{0.18cm}
}

