    \fill[CVTeal] (current page.north west) rectangle ([xshift=0.39cm,yshift=-5.43cm]current page.north west);
    \node[anchor=north west,text width=13.35cm,inner sep=0pt] at ([xshift=1.48cm,yshift=-1.15cm]current page.north west) {#1};
    \begin{scope}
      \clip ([xshift=-4.16cm,yshift=-2.72cm]current page.north east) circle (1.84cm);
      \node[inner sep=0pt] at ([xshift=-4.16cm,yshift=-2.72cm]current page.north east) {\includegraphics[width=3.68cm]{assets/profile-square.jpg}};
    \end{scope}
